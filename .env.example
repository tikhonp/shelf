# Copy to .env for `make dev`. Every variable is optional; the defaults are
# shown commented out. An unset variable takes its default, and one set to an
# empty value is empty. The meanings are in docs/architecture.md#configuration.

# SHELF_DATA_DIR=/data
# SHELF_MUSIC_DIR=/music
# SHELF_HTTP_ADDR=:8080
# SHELF_PUBLIC_URL=
# SHELF_TIMEZONE=Europe/Moscow
# SHELF_PROXY_URL=

# Qobuz is off while the token is empty.
# SHELF_QOBUZ_TOKEN=
# SHELF_QOBUZ_DIR=qobuz
# SHELF_QOBUZ_QUALITY=27
# SHELF_QOBUZ_FALLBACK=true
# SHELF_QOBUZ_WORKERS=3
# SHELF_QOBUZ_DELAY=0s
# SHELF_QOBUZ_USE_PROXY=false

# Apple Music is off when SHELF_AMDL_CONFIG is set to empty.
# SHELF_AMDL_CONFIG=/config/amdl.yaml
# SHELF_AMDL_TIMEOUT=2h
# SHELF_APPLE_DIR=apple-music
# SHELF_WRAPPER_URL=http://apple-music-wrapper:12340
# SHELF_WRAPPER_CONTROL_URL=http://apple-music-wrapper:12341
# SHELF_WRAPPER_TOKEN=

# Scans are off when SHELF_NAVIDROME_URL is set to empty.
# SHELF_NAVIDROME_URL=http://navidrome:4533
# SHELF_NAVIDROME_USER=
# SHELF_NAVIDROME_PASSWORD=
# SHELF_NAVIDROME_SCAN_DELAY=30s

# The bot is off while the token is empty.
# SHELF_TELEGRAM_TOKEN=
# SHELF_TELEGRAM_USERS=
# SHELF_TELEGRAM_USE_PROXY=false

# SHELF_DEV_FAKE_SOURCE=false
# SHELF_LOG_LEVEL=info
